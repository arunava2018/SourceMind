# NeonDB connection string (pooled)
# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql://username:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# JWT Secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# JWT token expiry (e.g., "7d" for 7 days, "24h" for 24 hours)
JWT_EXPIRES_IN="7d"
OPENAI_API_KEY=""